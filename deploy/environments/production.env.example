# Net Sec Watch production environment
# Copy to an ignored environment file and provide secrets through a secret
# manager or deployment platform, not Git.
DEPLOYMENT_ENVIRONMENT=production
OPENSEARCH_HTTP_BIND=127.0.0.1
OPENSEARCH_DASHBOARDS_BIND=127.0.0.1
SYSLOG_BIND=0.0.0.0
OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g
FLUENT_BIT_HTTP_BIND=127.0.0.1
AUDIT_FAIL_ON=high
